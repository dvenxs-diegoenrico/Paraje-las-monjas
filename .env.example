# Copy to .env.local for local development. Set real values in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Resend (https://resend.com) — API key with "sending" permission
RESEND_API_KEY=
# Where inquiries are delivered (comma-separated for several recipients)
INQUIRY_TO_EMAIL=
# Verified sender in Resend, e.g. "Paraje Las Monjas <hola@tu-dominio.mx>"
INQUIRY_FROM_EMAIL=

# Cloudflare Turnstile (optional but recommended). If unset, the form relies on honeypot + rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical origin used for metadata, sitemap and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://paraje-las-monjas.vercel.app
